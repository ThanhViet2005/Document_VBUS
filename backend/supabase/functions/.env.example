# Secrets cho Edge Functions. KHÔNG commit file .env thật.
# Local:      npx supabase functions serve --env-file supabase/functions/.env
# Production: npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY được Supabase tự cấp.)

# AI Chat (Edge Function ai-chat) dùng Groq: https://console.groq.com/keys (key dạng gsk_...).
# Để trống thì AI Chat dùng bộ hiểu câu tiếng Việt có sẵn trong app. Model mặc định: qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_MODEL=


# Origin được phép gọi function, cách nhau bởi dấu phẩy. Để trống = cho phép tất cả (*).
ALLOWED_ORIGINS=

# Web Push (send-reminders). Tạo khóa: npm run vapid:generate (trong thư mục backend)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Chuỗi bí mật ngẫu nhiên; cron gửi trong header x-cron-secret
CRON_SECRET=

# Email tổng hợp mỗi sáng (send-email-digest) qua Brevo: https://app.brevo.com → SMTP & API → API Keys (dạng xkeysib-...)
BREVO_API_KEY=
# Email gửi ĐÃ XÁC MINH trên Brevo (Senders, Domains & Dedicated IPs → Senders)
EMAIL_FROM=
EMAIL_FROM_NAME=UniPlan
# Địa chỉ web của app (Vercel), không có / ở cuối: dùng cho link trong email và link hủy nhận
APP_URL=
