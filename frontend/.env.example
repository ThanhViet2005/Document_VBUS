# Cấu hình lúc build (chỉ lập trình viên). Trên Vercel: Settings → Environment Variables, cùng tên biến.
# Chỉ giá trị CÔNG KHAI: Supabase URL gốc (không có /rest/v1), anon/publishable key, VAPID public key.
# Service role key & key bí mật để trong Supabase Edge Functions (backend/supabase/functions/.env).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
