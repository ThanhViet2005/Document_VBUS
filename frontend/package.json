{
  "name": "uniplan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npx --yes vercel deploy --prod",
    "deploy:preview": "npx --yes vercel deploy",
    "deploy:maintenance": "npx --yes vercel deploy --prod --build-env VITE_MAINTENANCE=1",
    "build:maintenance": "tsc -b && vite build --mode maintenance",
    "vercel:link": "npx --yes vercel link"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0"
  }
}
